{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*",
        "./*"
      ],
      "app/*": [
        "./app/*",
        "./src/app/*"
      ],
      "components/*": [
        "./components/*",
        "./src/components/*"
      ],
      "lib/*": [
        "./lib/*",
        "./src/lib/*"
      ],
      "types/*": [
        "./types/*",
        "./src/types/*"
      ],
      "utils/*": [
        "./utils/*",
        "./src/utils/*"
      ],
      "services/*": [
        "./services/*",
        "./src/services/*"
      ],
      "models/*": [
        "./models/*",
        "./src/models/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts"
  ]
}
